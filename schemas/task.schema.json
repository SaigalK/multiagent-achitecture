{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multiagent/task.schema.json",
  "title": "Multiagent Task",
  "type": "object",
  "required": [
    "project_id",
    "run_id",
    "task_id",
    "step_id",
    "state_version",
    "agent",
    "priority",
    "status",
    "title",
    "description",
    "input",
    "expected_output",
    "constraints",
    "created_at"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "parent_task_id": { "type": ["string", "null"] },
    "step_id": { "type": "string", "minLength": 1 },
    "state_version": { "type": "integer", "minimum": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "failed", "blocked", "review", "needs_clarification"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "input": {
      "type": "object",
      "required": ["requirements", "context", "input_artifacts"],
      "properties": {
        "requirements": { "type": "array", "items": { "type": "string" } },
        "context": { "type": "object" },
        "input_artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      },
      "additionalProperties": true
    },
    "expected_output": {
      "type": "object",
      "required": ["artifact_types", "acceptance_criteria"],
      "properties": {
        "artifact_types": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "required": ["max_tokens", "timeout_sec", "do_not"],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1 },
        "timeout_sec": { "type": "integer", "minimum": 1 },
        "do_not": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "type", "format", "name", "content"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "content": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}