{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multiagent/result.schema.json",
  "title": "Multiagent Result",
  "type": "object",
  "required": [
    "project_id",
    "run_id",
    "task_id",
    "agent",
    "status",
    "summary",
    "artifacts",
    "issues",
    "decisions",
    "next_actions",
    "metrics",
    "completed_at"
  ],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "failed", "blocked", "needs_clarification", "review"] },
    "summary": { "type": "string", "minLength": 1 },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "metrics": {
      "type": "object",
      "required": ["tokens_used", "execution_time_sec"],
      "properties": {
        "tokens_used": { "type": "integer", "minimum": 0 },
        "execution_time_sec": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "type", "name", "format", "content"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "content": {}
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "message": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}